# Copy this file to .env.local and fill values from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Only needed for server-side employee invitation. Never prefix this with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Needed only by the local demo-account seed command. Never expose this to the browser.
# Set it in the shell before running `npm run demo:accounts`.
# For the local signup-page demo button, also set DEMO_ACCOUNTS_ENABLED=true.
# Never enable demo provisioning in production.
#
# DEMO_ACCOUNTS_ENABLED=true
